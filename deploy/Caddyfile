# /etc/caddy/Caddyfile
#
# Caddy obtains and renews Let's Encrypt certificates automatically; there is
# no certbot cron job and no cPanel SSL manager to babysit. Reload after edits:
#   sudo caddy validate --config /etc/caddy/Caddyfile && sudo systemctl reload caddy

sumanyuj.com, www.sumanyuj.com {
	# Canonicalise on the apex so the site has one address.
	@www host www.sumanyuj.com
	redir @www https://sumanyuj.com{uri} permanent

	root * /var/www/sumanyuj.com/current
	encode zstd gzip

	header {
		# HSTS. Start with a short max-age; raise it once you're confident.
		Strict-Transport-Security "max-age=86400; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}

	# Vite fingerprints everything under /assets, so it can be cached hard.
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# The HTML entry point must never be cached, or clients keep loading the
	# previous release's asset URLs after a deploy.
	@html path / /index.html
	header @html Cache-Control "no-cache"

	# The app has no client-side router, so there is no SPA fallback: an
	# unknown path is a real 404 rather than the homepage served under the
	# wrong URL.
	file_server
	handle_errors {
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}

	# Sibling apps (one-thing, accountability) are not hosted here yet. When
	# they move over, give each its own root outside the site directory so a
	# bad deploy of the homepage cannot touch them:
	#
	#   handle_path /one-thing* {
	#       root * /var/www/one-thing
	#       file_server
	#   }
	#
	# ...or, if the app is a service rather than static files:
	#
	#   handle_path /accountability* {
	#       reverse_proxy 127.0.0.1:3000
	#   }

	log {
		output file /var/log/caddy/sumanyuj.com.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
